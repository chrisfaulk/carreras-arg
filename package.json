{
  "name": "carreras-arg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint . && eslint . && prettier --check .",
    "lint:fix": "oxlint --fix .",
    "db:migrate": "pnpm --filter backend db:migrate",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js,json}": [
      "oxlint --fix",
      "prettier --write",
      "oxlint",
      "eslint"
    ]
  },
  "devDependencies": {
    "@oxlint/plugins": "1.85.0",
    "@typescript-eslint/parser": "8.45.0",
    "eslint": "9.36.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.3",
    "oxlint": "1.85.0",
    "prettier": "3.6.2",
    "turbo": "2.5.4"
  }
}
